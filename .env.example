# GEMINI_API_KEY: Chave para o assistente IA (Gemini Flash Lite — recomendado, mais barato).
# Em produção defina-a como secret da Edge Function: supabase secrets set GEMINI_API_KEY=...
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: Alternativa ao Gemini (opcional).
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# PocketBase (só para scripts/migrar-pocketbase-supabase.mjs)
PB_URL="http://127.0.0.1:8090"
PB_ADMIN_EMAIL="admin@livraria.local"
PB_ADMIN_PASSWORD="Admin123456!"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
