rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Admin override check if we want, otherwise default to email check or metadata
      return isSignedIn() && (
        request.auth.token.email == 'ValentinoCanguele@gmail.com'
      );
    }

    // User profile rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
      
      match /profile/custom {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // Order rules
    match /orders/{orderId} {
      // Users can query their own orders by email or userId, and admins can view all
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.customer_email == request.auth.token.email
        )
      );
      
      // Allow creation of orders (guest or signed in)
      allow create: if true;
      
      // Only admins or the owner can update the order (such as changing delivery status)
      allow update, delete: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
    }

    // Notification logs rules (SMTP emails and WhatsApp Business logs)
    match /notification_logs/{logId} {
      allow read, write: if true;
    }
  }
}
