rules_version = '2';

// O site já não guarda dados no Firestore: encomendas, lista de desejos, avaliações
// e registos de comunicações estão no Supabase. O Firebase serve só para o login
// das ferramentas do Google Workspace no painel. Tudo fechado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
