# Copia este ficheiro para ".env" e preenche com os teus dados reais.
# NÃO partilhes o ficheiro ".env" preenchido com ninguém.

PB_URL=https://o-teu-pocketbase.exemplo.com
PB_ADMIN_EMAIL=admin@exemplo.com
PB_ADMIN_PASSWORD=a_tua_password_aqui

# Nome da coleção no PocketBase onde os livros vão ser criados
PB_COLLECTION=livros
